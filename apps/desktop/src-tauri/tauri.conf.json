{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EkidongoMIDI",
  "version": "0.1.0",
  "identifier": "com.ekidongomidi.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EkidongoMIDI",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.ingest.us.sentry.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNTJBOURBRjRGQTQ0N0MKUldSOFJQcjAycWxTRXkyMHBXQXhEbTdjbExLSGpDajhHekZsREthUVJlT0VQWCtYYjV3VWQ3OU8K",
      "endpoints": [
        "https://github.com/SPKyagulanyi/EkidongoMIDI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
